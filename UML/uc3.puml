@startuml
left to right direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 35

actor "Gracz" as Player

rectangle "System Godmist - Handel, crafting i questy" {

  rectangle "Handel" {
    usecase "Handel\nz NPC" as UC1
    usecase "Kupowanie\nprzedmiotów" as D1
    usecase "Sprzedawanie\nprzedmiotów" as D2
    usecase "Odkup\nprzedmiotów" as D3

    UC1 -[hidden]down-> D1
    D1 -[hidden]right-> D2
    D2 -[hidden]right-> D3
  }

  rectangle "Questy" {
    usecase "Zarządzanie\nquestami" as UC3
    usecase "Przyjęcie\nquesta" as D10
    usecase "Śledzenie postępu\nquesta" as D11
    usecase "Zakończenie\nquesta" as D12

    UC3 -[hidden]down-> D10
    D10 -[hidden]right-> D11
    D11 -[hidden]right-> D12
  }

  rectangle "Crafting" {
    usecase "Crafting\nu NPC" as UC2

    usecase "Tworzenie\nprzedmiotów" as D4
    usecase "Ulepszanie\nwyposażenia" as D5
    usecase "Przekuwanie\nwyposażenia" as D6

    usecase "Infuzja\nwyposażenia" as D7
    usecase "Identyfikacja\ngaldurytów" as D8
    usecase "Osadzanie\ngaldurytów" as D9

    UC2 -[hidden]down-> D5
    D4 -[hidden]right-> D5
    D5 -[hidden]right-> D6

    D7 -[hidden]right-> D8
    D8 -[hidden]right-> D9

    D5 -[hidden]down-> D8
  }
}

Player --> UC1
Player --> UC2
Player --> UC3

UC1 .> D1 : <<include>>
UC1 .> D2 : <<include>>
UC1 .> D3 : <<include>>

UC2 .> D4 : <<include>>
UC2 .> D5 : <<include>>
UC2 .> D6 : <<include>>
UC2 .> D7 : <<include>>
UC2 .> D8 : <<include>>
UC2 .> D9 : <<include>>

UC3 .> D10 : <<include>>
UC3 .> D11 : <<include>>
UC3 .> D12 : <<include>>

@enduml