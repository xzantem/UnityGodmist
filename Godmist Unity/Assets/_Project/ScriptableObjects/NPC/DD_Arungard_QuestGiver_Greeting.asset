  <Id>k__BackingField: dialogue.arungard.questgiver.greeting
  <StartNodeId>k__BackingField: greeting
  <Nodes>k__BackingField:
  - <NodeId>k__BackingField: greeting
    <SpeakerId>k__BackingField: npc.arungard.questgiver_01
    <Text>k__BackingField: "Katakumby nie wybaczaj\u0105 nieostro\u017Cno\u015Bci."
    <Choices>k__BackingField:
    - <ChoiceId>k__BackingField: choice.ask
      <DisplayText>k__BackingField: "Co znajduje si\u0119 w Katakumbach?"
      <NextNodeId>k__BackingField: warning
      <QuestAction>k__BackingField:
        <QuestId>k__BackingField: 
        <MakeQuestAvailable>k__BackingField: 0
        <StartQuest>k__BackingField: 0
        <QuestBranchId>k__BackingField: 
    - <ChoiceId>k__BackingField: choice.goodbye
      <DisplayText>k__BackingField: Do widzenia.
      <NextNodeId>k__BackingField: 
      <QuestAction>k__BackingField:
        <QuestId>k__BackingField: 
        <MakeQuestAvailable>k__BackingField: 0
        <StartQuest>k__BackingField: 0
        <QuestBranchId>k__BackingField: 
  - <NodeId>k__BackingField: warning
    <SpeakerId>k__BackingField: npc.arungard.questgiver_01
    <Text>k__BackingField: "Nieumarli, pu\u0142apki i stare grobowce. Je\u015Bli
      wejdziesz, zachowaj ostro\u017Cno\u015B\u0107."
    <Choices>k__BackingField:
    - <ChoiceId>k__BackingField: choice.accept_investigate_catacombs
      <DisplayText>k__BackingField: Zbadam Katakumby.
      <NextNodeId>k__BackingField: 
      <QuestAction>k__BackingField:
        <QuestId>k__BackingField: quest.arungard.investigate_catacombs.v1
        <MakeQuestAvailable>k__BackingField: 1
        <StartQuest>k__BackingField: 1
        <QuestBranchId>k__BackingField: 
    - <ChoiceId>k__BackingField: choice.goodbye
      <DisplayText>k__BackingField: Rozumiem.
      <NextNodeId>k__BackingField: 
      <QuestAction>k__BackingField:
        <QuestId>k__BackingField: 
